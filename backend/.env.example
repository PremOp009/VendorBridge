# VendorBridge Backend Environment Variables
# Copy this file to .env and fill in your values

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/vendorbridge
# For SQLite (development fallback):
# DATABASE_URL=sqlite:///vendorbridge.db

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Email (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=VendorBridge <your-email@gmail.com>

# App
APP_NAME=VendorBridge
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Your Company Address
COMPANY_GST=Your GST Number
FRONTEND_URL=http://localhost:5500
UPLOAD_FOLDER=uploads
PDF_FOLDER=pdfs
